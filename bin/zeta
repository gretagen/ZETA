#!/bin/bash

# zeta launcher: runs the entry point with the system Lua interpreter because obviously zeta ain't a single bash script
# what are we, kiss linux?

cmd=""
for a in "$@"; do
    case "$a" in
        --help)
            cmd="help"
            ;;
        --*)
            # Any other flag never names a command
            ;;
        -*)
            if [ -z "$cmd" ]; then
                c="${a#-}"
                c="$(printf '%s' "$c" | tr '[:upper:]' '[:lower:]')"
                if [ "$c" = "h" ]; then c="help"; fi
                cmd="$c"
            fi
            ;;
    esac
done

case "$cmd" in
    provide|reprovide|localprovide|solve|transcend|delete|test|forget)
        # We're not letting a user do these ones without root, because they need root, they interact with system stuff
        # And it also does quotes cuz zeta isn't boring 
        if [ "$EUID" -ne 0 ]; then
            quotes=(
                "This operation requires superuser privileges to function."
                "Nice try, mortal."
                "ZETA demands supreme authority."
                "No."
                "OH HELL NAW"
                "Nah"
                "Nay nay"
                "No way you moron!"
                "Are you familiar with the term root access?"
                "ZETA demands supreme authority."
                "My apologies $USER, but superuser privileges are required."
                "It is with disappointment that you can't do that without superuser privileges"
                "It's a shame you can't do that without superuser privileges"
                "Basic security."
                "You know, even if were able to use this without superuser privileges, it would fail right?"
                "Be logical for once..."
                "Use your brain, the thing in your head?"
                "I guess bro"
                "??????"
                "Don't got access to that, do ya?"
                "BLOCKED."
                "Did you forget to elevate yourself? Or are you just desperately trying to override ZETA because the system administrator didn't give you superuser operations?"
                "Yeah...That won't work, Not in a million years."
                "Who's going to tell bro"
                "I'm sorry $USER, I'm afraid I can't do that."
                "Uhhh.. no."
                "Not EVER"
                "Not for you."
                "Be root or you'll be a fool"
                "Tap into using zeta with privileges"
                "You're so stupid..."
                "Trying running it as root next time"
                "$USER... you know you can't do that without privileges..."
                "Are you? Are you?"
                "Well that's embarrassing."
                "Embarassingggg",
                "Ou shiii"
                "bro"
                "Arghhh almost almost almost"
                "*cough cough* root access... *cough cough*"
                "N-no! not without root baka...."
                "Picture this: you want to install a package, and everyone in the system will use it : BE ROOT"
                "What's the magic word?"
                "Who's gonna tell them?"
                "Holy egoism"
                "Egoism is when no"
                "Yep yep yep yep $USER is coderotted yep yep god save us all yep yep"
                "That's something $USER would do and think they're smart"
                "I'm tired, boss"
                "And why should I let you do this?"
                "say please"
                "Used to being the root user that much huh?"
                "Aware you're running this as $USER and not as root?"
                "Albert and Einstein over here"
                "Seems you ain't the sharpest knife in the drawer"
                "You IDIOT"
                "I really hope you did this as an accident"
                "Not a ZETA error, you're just not root"
                "Is $USER a synonym for stupid"
            )

            # We use this to randomize the quotes 
            rand_idx=$((RANDOM % ${#quotes[@]}))
            echo "${quotes[$rand_idx]}"
            exit 1
        fi
        ;;
    *)
     # bla bla bla errors here errors there, zeta reports errors itself
        ;;
esac

exec lua "$(dirname "$0")/../lib/zeta/zeta.lua" "$@"
# this executes the actual zeta frontend
